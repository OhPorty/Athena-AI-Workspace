{% macro icon(name, color) -%}
<svg class="icon" viewBox="0 0 24 24" stroke="{{ color }}" aria-hidden="true">
{% if name == "pin" %}<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
{% elif name == "phone" %}<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
{% elif name == "mail" %}<path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><polyline points="22,6 12,13 2,6"/>
{% else %}<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
{% endif %}
</svg>
{%- endmacro %}

{# Experience/education entries shared by every resume template. #}
{% macro experience(items) %}
{% for e in items %}
<div class="entry{{ ' keep' if e.bullets|length <= 6 }}">
  <div class="eh"><span class="et">{{ e.title or e.company }}</span>{% if e.dates %}<span class="ed">{{ e.dates }}</span>{% endif %}</div>
  {% if e.title and (e.company or e.location) %}
  <div class="es">{{ e.company }}{% if e.company and e.location %}<span class="sep">|</span>{% endif %}{% if e.location %}<span class="loc">{{ e.location }}</span>{% endif %}</div>
  {% endif %}
  {% if e.bullets %}<ul class="bul">{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
</div>
{% endfor %}
{% endmacro %}

{% macro custom_sections(items) %}
{% for s in items %}
<section class="sec">
  <h2 class="sec-title">{{ s.title }}</h2>
  {% if s.text %}<p class="summary">{{ s.text }}</p>{% endif %}
  {% if s.items %}<ul class="bul">{% for it in s.items %}<li>{{ it }}</li>{% endfor %}</ul>{% endif %}
</section>
{% endfor %}
{% endmacro %}
